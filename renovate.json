{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges",
    "customManagers:mavenPropertyVersions"
  ],
  "packageRules": [
    {
      "groupName": "Angular",
      "matchCategories": ["js"],
      "matchPackageNames": [
        "@angular/**"
      ]
    },
    {
      "groupName": "Angular ESLint",
      "matchCategories": ["js"],
      "matchPackageNames": [
        "@angular-eslint/**",
        "angular-eslint"
      ]
    },
    {
      "description": "Disable Spring Boot major and minor version updates",
      "matchCategories": ["java"],
      "matchUpdateTypes": ["major","minor"],
      "matchPackageNames": [
        "org.springframework.boot"
      ],
      "enabled": false
    },
    {
      "description": "Disable Docker major version updates",
      "matchCategories": ["docker"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Restrict Angular compatibility matrix dependencies to patch updates",
      "matchCategories": ["js"],
      "matchUpdateTypes": ["major", "minor"],
      "matchPackageNames": [
        "@angular/**",
        "typescript",
        "rxjs"
      ],
      "enabled": false
    },
    {
      "description": "Disable major version updates for JavaScript dependencies",
      "matchCategories": ["js"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}